        + " -> "
        + str(after["visible"])
    )

    LOG(
        "Hidden  : "
        + str(before["hidden"])
        + " -> "
        + str(after["hidden"])
    )

    if (
        before["visible"] != after["visible"]
        or
        before["hidden"] != after["hidden"]
    ):

        LOG("★★ RECOMPUTEによって変化しています")

    else:

        LOG("変化なし")


