    LOG("----------------------------------------")
    LOG("View[" + str(i) + "]")
    LOG("----------------------------------------")

    try:
        LOG("Name     = " + str(view.Name))
    except:
        pass

    try:
        LOG("Label    = " + str(view.Label))
    except:
        pass

    try:
        LOG("TypeId   = " + str(view.TypeId))
    except:
        pass

    try:
        LOG("Direction= " + str(view.Direction))
    except:
        pass

    try:
        LOG("X        = " + str(view.X))
    except:
        pass

    try:
        LOG("Y        = " + str(view.Y))
    except:
        pass

    try:
        LOG("Scale    = " + str(view.Scale))
    except:
        pass

    LOG("")


# ============================================================
# BEFORE RECOMPUTE
# ============================================================

LOG("")
LOG("========================================")
LOG("BEFORE RECOMPUTE")
LOG("========================================")
LOG("")

before_data = {}


for view in views:

    try:
        if view.TypeId != "TechDraw::DrawProjGroupItem":

            LOG(
                "SKIP: "
                + str(view.Label)
                + " / "
                + str(view.TypeId)
            )

            continue

    except Exception as e:

        LOG("TypeId確認失敗: " + str(e))
        continue


    label = str(view.Label)

    LOG("----------------------------------------")
    LOG("VIEW: " + label)
    LOG("----------------------------------------")


    # --------------------------------------------------------
    # 基本情報
    # --------------------------------------------------------

    try:
        LOG("Direction = " + str(view.Direction))
    except Exception as e:
        LOG("Direction ERROR: " + str(e))

    try:
        LOG("X = " + str(view.X))
    except Exception as e:
        LOG("X ERROR: " + str(e))

    try:
        LOG("Y = " + str(view.Y))
    except Exception as e:
        LOG("Y ERROR: " + str(e))

    try:
        LOG("Scale = " + str(view.Scale))
    except Exception as e:
        LOG("Scale ERROR: " + str(e))


    # --------------------------------------------------------
    # Visible
    # --------------------------------------------------------

    try:

        visible_edges = list(
            view.getVisibleEdges()
        )

        visible_count = len(visible_edges)

        LOG(
            "Visible Edges = "
            + str(visible_count)
        )

    except Exception as e:

        visible_edges = []

        LOG(
            "getVisibleEdges ERROR: "
            + str(e)
        )


    # --------------------------------------------------------
    # Hidden
    # --------------------------------------------------------

    try:

        hidden_edges = list(
            view.getHiddenEdges()
        )

        hidden_count = len(hidden_edges)

        LOG(
            "Hidden Edges = "
            + str(hidden_count)
        )

    except Exception as e:

        hidden_edges = []

        LOG(
            "getHiddenEdges ERROR: "
            + str(e)
        )


    before_data[label] = {

        "visible": visible_count
        if "visible_count" in locals()
        else 0,

        "hidden": hidden_count
        if "hidden_count" in locals()
        else 0

    }


    # --------------------------------------------------------
    # Edge種類
    # --------------------------------------------------------

    visible_types = {}

    for edge in visible_edges:

        try:

            cname = type(edge.Curve).__name__

            visible_types[cname] = (
                visible_types.get(cname, 0) + 1
            )

        except Exception:
            pass


    hidden_types = {}

    for edge in hidden_edges:

        try:

            cname = type(edge.Curve).__name__

            hidden_types[cname] = (
                hidden_types.get(cname, 0) + 1
            )

        except Exception:
            pass


    LOG(
        "Visible Curve Types = "
        + str(visible_types)
    )

    LOG(
        "Hidden Curve Types  = "
        + str(hidden_types)
    )

    LOG("")


