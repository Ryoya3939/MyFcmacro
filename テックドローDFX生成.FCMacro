        "hidden": hidden_count

    }


    # --------------------------------------------------------
    # Edge種類
    # --------------------------------------------------------

    visible_types = {}

    for edge in visible_edges:

        try:

            cname = type(edge.Curve).__name__

            visible_types[cname] = (
                visible_types.get(cname, 0) + 1
            )

        except Exception:
            pass


    hidden_types = {}

    for edge in hidden_edges:

        try:

            cname = type(edge.Curve).__name__

