    QtWidgets.QMessageBox.critical(
        None,
        "TechDraw診断",
        "アクティブなドキュメントがありません。"
    )
    raise Exception("ActiveDocumentがありません")


proj = doc.getObject("ProjGroup")

if proj is None:
    QtWidgets.QMessageBox.critical(
        None,
        "TechDraw診断",
        "ProjGroupがありません。"
    )
    raise Exception("ProjGroupがありません")


# ============================================================
# ログ
