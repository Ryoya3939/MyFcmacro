# ============================================================
# BEFORE / AFTER 比較
# ============================================================

LOG("")
LOG("========================================")
LOG("BEFORE / AFTER 比較")
LOG("========================================")
LOG("")


for label in after_data:

    before = before_data.get(
        label,
        {
            "visible": 0,
            "hidden": 0
        }
    )

    after = after_data[label]

    LOG("----------------------------------------")
